# Copie ce fichier en « .env » (il est ignoré par git) pour le développement local.
# En production, définis ces variables chez ton hébergeur — jamais dans le code.

# Clé API OpenRouter (https://openrouter.ai/keys). NE LA PARTAGE JAMAIS.
OPENROUTER_API_KEY=

# Clé API Groq (https://console.groq.com/keys). NE LA PARTAGE JAMAIS.
GROQ_API_KEY=

# Optionnel en local :
# DEBUG=True
# SECRET_KEY=une-longue-chaine-aleatoire
